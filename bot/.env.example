# Токен бота, выданный организаторами хакатона. НЕ коммитить реальное
# значение — только в .env (он уже в .gitignore).
BOT_TOKEN=

# См. src/config.ts — точный формат (прямой HTTPS-адрес мини-аппа или
# deep-link вида https://max.ru/<botUsername>?startapp=...) не подтверждён
# по официальной документации на момент написания, сверить при первой
# возможности (dev.max.ru был недоступен из рабочей среды).
MINI_APP_URL=

# user_id пользователей MAX, которым доступна команда /announce и кнопка
# "Панель администратора" в мини-апп, через запятую без пробелов.
# Свой user_id можно узнать из лога бота при первом /start (он печатает
# ctx.user на новые события) либо через npm run whoami для самого бота.
ADMIN_USER_IDS=

# Общий секрет для внутреннего эндпоинта POST /notify (см. src/notifyServer.ts),
# которым бэкенд подтверждает, что запрос на уведомление пришёл от него.
NOTIFY_SECRET=change-me
NOTIFY_PORT=8081
